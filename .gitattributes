# Normalize text; keep Windows scripts CRLF
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Binary assets
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.mp3 binary
*.wav binary
*.zip binary
*.nbt binary

# Datagen / JSON cache line endings
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf
